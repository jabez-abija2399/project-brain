# Codeceipt: copy to .env and fill in. Never commit real values. Keep this file current: every env var the
# code reads is listed here with a comment (what it is, where to get it, how to generate it).
# Wrap values that contain '&', '|', ';', '#', '$' or spaces in double quotes (Neon URLs typically have '&').
DATABASE_URL=""                         # Neon console > project-brain > branch 'dev' > Connect > connection string (production uses the main branch or a separate project)
BETTER_AUTH_SECRET=""                   # openssl rand -base64 32
BETTER_AUTH_URL=http://localhost:3000   # public URL of the web app
GITHUB_CLIENT_ID=                       # GitHub > Settings > Developer settings > OAuth Apps (sign-in)
GITHUB_CLIENT_SECRET=
GITHUB_APP_ID=                          # GitHub > Developer settings > GitHub Apps (repo access + webhooks, FEAT-009)
GITHUB_APP_PRIVATE_KEY=                 # the whole .pem file, with real newlines or with each newline written as \n
GITHUB_WEBHOOK_SECRET=                  # openssl rand -hex 32, same value in the GitHub App settings
ANTHROPIC_API_KEY=                      # console.anthropic.com > API keys
AI_CALLS_PER_PROJECT_PER_DAY=           # optional; daily AI-call budget per project (UTC day), default 2000
REQUEST_CAPTURES_PER_PROJECT_PER_DAY=   # optional; requests the prompt hooks may store per project per day, default 500
INDEX_MAX_FILES_PER_PROJECT=            # optional; stored files per project, default 10000
INDEX_MAX_SYMBOLS_PER_PROJECT=          # optional; stored symbols per project, default 100000
ADMIN_GITHUB_LOGINS=                    # optional; comma-separated GitHub logins that may open /admin/waitlist
# CLI (user machine, not the server): optional overrides for `codeceipt login` (the old PROJECTBRAIN_* names still work)
CODECEIPT_API_URL=                      # API base URL; default https://codeceipts.vercel.app (or --api-url); https unless localhost
CODECEIPT_TOKEN=                        # project token from the dashboard; otherwise login reads it from stdin
GITHUB_APP_SLUG=                        # the App's URL name (github.com/apps/<slug>), FEAT-009 install link
GITHUB_APP_CLIENT_ID=                   # the GitHub App's own OAuth client (Request user authorization during installation)
GITHUB_APP_CLIENT_SECRET=
INNGEST_EVENT_KEY=                      # Inngest > Manage > Event keys (sending the push event); empty with `npx inngest-cli dev`
INNGEST_SIGNING_KEY=                    # Inngest > Manage > Signing key (verifies calls to /api/inngest)
RESEND_API_KEY=                         # optional (owner action 12): resend.com > API Keys; empty = no approval emails
RESEND_FROM=                            # a sender on a domain verified in Resend, e.g. Codeceipt <alerts@yourdomain.com>
STRIPE_SECRET_KEY=                      # FEAT-025 billing (Stripe > Developers > API keys); empty = no plans and no limits
STRIPE_WEBHOOK_SECRET=                  # Stripe > Developers > Webhooks, endpoint <app>/api/billing/webhook
STRIPE_PRICE_BUILDER=                   # Stripe price ids (monthly) for each paid plan
STRIPE_PRICE_PRO=
STRIPE_PRICE_AGENCY=
STRIPE_COUPON_FOUNDING=                 # coupon: $4 off for 12 months (Builder at $8), max_redemptions=200 (Stripe enforces the cap)
# Production (docs/deploy.md): the server refuses to start without DATABASE_URL, BETTER_AUTH_SECRET, BETTER_AUTH_URL,
# GITHUB_CLIENT_ID/SECRET, GITHUB_APP_ID, GITHUB_APP_PRIVATE_KEY, GITHUB_WEBHOOK_SECRET, ANTHROPIC_API_KEY and the two
# INNGEST keys; /api/health shows which optional services are configured (true/false, never values).
