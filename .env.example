# Project Brain: copy to .env and fill in. Never commit real values. Keep this file current: every env var the
# code reads is listed here with a comment (what it is, where to get it, how to generate it).
# Wrap values that contain '&', '|', ';', '#', '$' or spaces in double quotes (Neon URLs typically have '&').
DATABASE_URL=""                         # Neon console > project-brain > branch 'dev' > Connect > connection string (production uses the main branch or a separate project)
BETTER_AUTH_SECRET=""                   # openssl rand -base64 32
BETTER_AUTH_URL=http://localhost:3000   # public URL of the web app
GITHUB_CLIENT_ID=                       # GitHub > Settings > Developer settings > OAuth Apps (sign-in)
GITHUB_CLIENT_SECRET=
GITHUB_APP_ID=                          # GitHub > Developer settings > GitHub Apps (repo access + webhooks, FEAT-009)
GITHUB_APP_PRIVATE_KEY=                 # the .pem contents, newlines as \n
GITHUB_WEBHOOK_SECRET=                  # openssl rand -hex 32, same value in the GitHub App settings
ANTHROPIC_API_KEY=                      # console.anthropic.com > API keys
AI_CALLS_PER_PROJECT_PER_DAY=           # optional; daily AI-call budget per project (UTC day), default 2000
INDEX_MAX_FILES_PER_PROJECT=            # optional; stored files per project, default 10000
INDEX_MAX_SYMBOLS_PER_PROJECT=          # optional; stored symbols per project, default 100000
INNGEST_EVENT_KEY=                      # Inngest Cloud only; leave empty with `npx inngest-cli dev`
INNGEST_SIGNING_KEY=
# CLI (user machine, not the server): optional overrides for `projectbrain login`
PROJECTBRAIN_API_URL=                   # API base URL; default http://localhost:3000 (or --api-url); https unless localhost
PROJECTBRAIN_TOKEN=                     # project token from the dashboard; otherwise login reads it from stdin
