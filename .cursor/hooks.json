{
  "version": 1,
  "hooks": {
    "beforeShellExecution": [ { "command": "python3 .claude/hooks/protect.py --agent cursor" } ],
    "beforeReadFile": [ { "command": "python3 .claude/hooks/protect.py --agent cursor --read" } ],
    "preToolUse": [ { "command": "python3 .claude/hooks/protect.py --agent cursor" } ]
  }
}
