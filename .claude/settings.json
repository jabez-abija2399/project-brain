{
  "permissions": {
    "deny": [
      "Read(./.env)", "Read(./.env.local)", "Read(./.env.*.local)", "Read(./.env.production)", "Read(./.env.development)",
      "Read(./.env.test)", "Read(./.env.staging)", "Read(**/.env)", "Read(**/.env.local)",
      "Edit(./.env)", "Edit(./.env.local)", "Edit(./.env.production)",
      "Bash(git commit --no-verify:*)", "Bash(git push --force:*)", "Bash(git push -f:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      { "hooks": [ { "type": "command", "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/kit.py\" brief" } ] }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash|Read|Grep",
        "hooks": [ { "type": "command", "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/protect.py\" --agent claude" } ]
      }
    ],
    "Stop": [
      { "hooks": [ { "type": "command", "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/kit.py\" stop-check" } ] }
    ]
  }
}
