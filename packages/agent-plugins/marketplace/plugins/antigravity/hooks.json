{
  "codeceipt": {
    "SessionStart": [
      {
        "type": "command",
        "command": "sh \"${PLUGIN_ROOT}/scripts/codeceipt.sh\" hook session-start antigravity",
        "timeout": 30
      }
    ],
    "PreToolUse": [
      {
        "type": "command",
        "command": "sh \"${PLUGIN_ROOT}/scripts/codeceipt.sh\" hook pre-tool antigravity",
        "timeout": 10
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "sh \"${PLUGIN_ROOT}/scripts/codeceipt.sh\" hook stop antigravity",
        "timeout": 30
      }
    ]
  }
}
